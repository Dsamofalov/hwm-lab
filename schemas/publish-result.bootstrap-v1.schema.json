{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hwm:schema:publish-result:bootstrap-v1",
  "title": "HWM controlled task-branch publish result bootstrap-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "status",
    "repository",
    "task_issue",
    "task_branch",
    "expected_head",
    "observed_head_before",
    "request_fingerprint",
    "idempotent_replay"
  ],
  "properties": {
    "schema": {
      "const": "hwm-publish-result/bootstrap-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_issue": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "task_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_head": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_head_before": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "new_head": {
      "$ref": "#/$defs/sha"
    },
    "commit_sha": {
      "$ref": "#/$defs/sha"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "ci_dispatch": {
      "$ref": "#/$defs/ci_dispatch"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "success"
        },
        "repository": {
          "const": "Dsamofalov/hwm-lab"
        },
        "task_issue": {
          "type": "integer",
          "minimum": 1
        },
        "task_branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_head": {
          "$ref": "#/$defs/sha"
        },
        "observed_head_before": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "new_head",
        "commit_sha",
        "changes",
        "ci_dispatch"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "new_head"
            ]
          },
          {
            "required": [
              "commit_sha"
            ]
          },
          {
            "required": [
              "changes"
            ]
          },
          {
            "required": [
              "ci_dispatch"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "blob_sha",
            "mode"
          ],
          "properties": {
            "op": {
              "const": "add"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "blob_sha": {
              "$ref": "#/$defs/sha"
            },
            "mode": {
              "type": "string",
              "enum": [
                "100644",
                "100755"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "blob_sha",
            "mode",
            "expected_blob_sha"
          ],
          "properties": {
            "op": {
              "const": "replace"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "blob_sha": {
              "$ref": "#/$defs/sha"
            },
            "mode": {
              "type": "string",
              "enum": [
                "100644",
                "100755"
              ]
            },
            "expected_blob_sha": {
              "$ref": "#/$defs/sha"
            }
          }
        }
      ]
    },
    "ci_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "head_sha"
      ],
      "properties": {
        "workflow": {
          "const": "infrastructure-ci.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_SCHEMA",
            "UNAUTHORIZED_AUTHOR",
            "REPOSITORY_NOT_ALLOWED",
            "TASK_NOT_CLAIMED",
            "BRANCH_TASK_MISMATCH",
            "EXPECTED_HEAD_MISMATCH",
            "FORBIDDEN_TARGET",
            "FORBIDDEN_PATH",
            "PATH_STATE_MISMATCH",
            "BLOB_NOT_FOUND",
            "BLOB_NOT_REGULAR",
            "REQUEST_ID_REUSE",
            "CI_DISPATCH_FAILED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
